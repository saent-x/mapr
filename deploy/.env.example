# deploy/.env.example — MAPR self-hosting env (ONE-command stack).
# Copy to deploy/.env and fill in, then:
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d
# NEVER commit the filled-in .env.
#
# EVERY ${VAR} referenced by docker-compose.yml is listed here. Convex *function*
# env (Stripe/Auth/JWT/Ollama/etc.) is applied automatically by the `bootstrap`
# one-shot via `convex env set` — you only fill the values below once.

# ============================================================================
# Convex backend (embedded SQLite backing store — no separate database)
# ============================================================================

# -- Convex backend identity --------------------------------------------------
# INSTANCE_NAME + INSTANCE_SECRET are fixed so generated admin keys stay valid
# across restarts. Data persists in the `convex_data` volume (SQLite + files).
INSTANCE_NAME=convex-self-hosted
# Stable secret so admin keys stay valid across restarts: `openssl rand -hex 32`.
INSTANCE_SECRET=change-me-instance-secret-32-byte-hex

# -- Convex public origins (the Cloudflare Tunnel hostnames, with https://) ---
# CONVEX_CLOUD_ORIGIN = API origin (:3210). Baked into the web app as VITE_CONVEX_URL.
# CONVEX_SITE_ORIGIN  = HTTP-actions/site origin (:3211). Stripe webhook + Convex
#                       Auth callbacks land here. Baked as VITE_CONVEX_SITE_URL.
CONVEX_CLOUD_ORIGIN=https://convex-api.example.com
CONVEX_SITE_ORIGIN=https://convex-site.example.com

# -- Map basemap (MapLibre) ---------------------------------------------------
# Defaults to Carto dark-matter (free, no key) fetched from Carto's CDN at
# runtime. For a fully self-contained deploy, self-host a vector style (e.g.
# OpenFreeMap or Protomaps PMTiles) and set its style.json URL here.
VITE_MAP_STYLE=

# -- Convex admin key (used by the `bootstrap` one-shot to deploy functions) --
# DETERMINISTIC from INSTANCE_SECRET. Generate it ONCE (after filling the values
# above) with:
#   docker compose -f deploy/docker-compose.yml run --rm --no-deps \
#     --entrypoint ./generate_admin_key.sh convex-backend
# Paste the printed `convex-self-hosted|...` value here.
CONVEX_SELF_HOSTED_ADMIN_KEY=change-me-run-generate_admin_key.sh

# ============================================================================
# Ingest
# ============================================================================

# Shared worker auth: the rust-ingestor sends this as ingestKey; the deployment
# checks it (set on Convex by bootstrap). `openssl rand -hex 24`.
MAPR_INGEST_KEY=change-me-ingest-secret
# Ingestor loop tuning (optional; defaults shown).
INGEST_INTERVAL_SECS=900
FETCH_TIMEOUT_SECS=20
RUST_LOG=info

# ============================================================================
# Ollama (embeddings + LLM)
# ============================================================================

# Model names served by the ollama container (auto-pulled by ollama-pull).
# EMBED_MODEL is used by BOTH the ingestor and the Convex functions (1024-dim).
EMBED_MODEL=bge-m3
LLM_MODEL=qwen2.5:3b
# Optional bearer if you front Ollama with auth (leave blank = off).
OLLAMA_BEARER=
# Optional cap on QA answer tokens (functions default to 384).
MAPR_QA_MAX_TOKENS=

# ============================================================================
# Auth / JWT  (applied to Convex by bootstrap via `convex env set`)
# ============================================================================

# Public web origin (Stripe redirects). The web tunnel host.
APP_ORIGIN=https://app.example.com

# Optional: daily-digest email delivery (Resend). Auth is email + password — no
# email transport is required to sign in. Leave blank to disable digest emails.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=MAPR <noreply@mapr.app>

# First admin(s): comma-separated emails. The auth callback grants role=admin on
# the FIRST sign-in of any address listed here. Set before first sign-in.
ADMIN_EMAILS=you@example.com

# Convex Auth signing keys — GENERATED, not hand-written. See README step 1 for
# the exact `jose` snippet. JWT_PRIVATE_KEY is single-line PKCS8 (newlines ->
# spaces); JWKS is the matching public JWKS JSON.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY----- ... -----END PRIVATE KEY-----"
JWKS={"keys":[{"use":"sig","kty":"RSA","n":"...","e":"AQAB"}]}

# ============================================================================
# Stripe  (applied to Convex by bootstrap; webhook secret comes after step 4)
# ============================================================================

STRIPE_SECRET_KEY=sk_live_xxx
# From the webhook endpoint you create at https://<CONVEX_SITE_ORIGIN>/stripe/webhook.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price ID of the Pro recurring price.
STRIPE_PRICE_PRO=price_xxx

# ============================================================================
# Tunnel
# ============================================================================
# cloudflared reads deploy/cloudflared/config.yml + <TUNNEL_ID>.json (NOT env).
# See deploy/cloudflared/config.example.yml for setup. The three public
# hostnames MUST equal APP_ORIGIN, CONVEX_CLOUD_ORIGIN and CONVEX_SITE_ORIGIN.
