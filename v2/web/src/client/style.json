{
  "version": 8,
  "name": "mapr-instrument",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sky": { "atmosphere-blend": 0 },
  "layers": [
    { "id": "land", "type": "background", "paint": { "background-color": "#171717" } },
    {
      "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
      "filter": ["all", ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false], ["!=", ["get", "brunnel"], "tunnel"]],
      "paint": { "fill-color": "#101010" }
    },
    {
      "id": "boundary_state", "type": "line", "source": "openmaptiles", "source-layer": "boundary", "minzoom": 4,
      "filter": ["all", [">=", ["coalesce", ["get", "admin_level"], 99], 3], ["<=", ["coalesce", ["get", "admin_level"], 0], 4], ["!=", ["get", "maritime"], 1]],
      "paint": { "line-color": "#262626", "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.5, 10, 1] }
    },
    {
      "id": "road_major", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 7,
      "filter": ["all", ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false], ["match", ["get", "class"], ["motorway", "trunk"], true, false]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#262626", "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.5, 12, 1.5] }
    },
    {
      "id": "boundary_country", "type": "line", "source": "openmaptiles", "source-layer": "boundary",
      "filter": ["all", ["==", ["get", "admin_level"], 2], ["!=", ["get", "maritime"], 1], ["!=", ["get", "disputed"], 1]],
      "layout": { "line-join": "round" },
      "paint": { "line-color": "#333333", "line-width": ["interpolate", ["linear"], ["zoom"], 0, 0.6, 6, 1.2] }
    },
    {
      "id": "boundary_disputed", "type": "line", "source": "openmaptiles", "source-layer": "boundary",
      "filter": ["all", ["!=", ["get", "maritime"], 1], ["==", ["get", "disputed"], 1]],
      "paint": { "line-color": "#333333", "line-width": 1, "line-dasharray": [2, 2] }
    },
    {
      "id": "label_city", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "minzoom": 4,
      "filter": ["all", ["==", ["get", "class"], "city"], ["<=", ["coalesce", ["get", "rank"], 99], ["step", ["zoom"], 3, 6, 6, 8, 10]]],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-max-width": 8
      },
      "paint": { "text-color": "#8A8A8A", "text-halo-color": "#171717", "text-halo-width": 1 }
    },
    {
      "id": "label_country", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "minzoom": 2, "maxzoom": 7,
      "filter": ["all", ["==", ["get", "class"], "country"], ["<=", ["coalesce", ["get", "rank"], 99], ["step", ["zoom"], 1, 3, 2, 4, 4]]],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 10,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1,
        "text-max-width": 7
      },
      "paint": { "text-color": "#8A8A8A", "text-halo-color": "#171717", "text-halo-width": 1 }
    }
  ]
}
