{
  "version": 8,
  "name": "mapr-light",
  "sources": {
    "ne_countries": {"type": "geojson", "data": {"type": "FeatureCollection", "features": []}, "promoteId": "a2"},
    "ne_borders": {"type": "geojson", "data": {"type": "FeatureCollection", "features": []}},
    "graticule": {"type": "geojson", "data": {"type": "FeatureCollection", "features": []}},
    "openmaptiles": {"type": "vector", "url": "https://tiles.openfreemap.org/planet"}
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sky": {"atmosphere-blend": 0},
  "layers": [
    {"id": "background", "type": "background", "paint": {"background-color": ["interpolate", ["linear"], ["zoom"], 4, "#D3D9D8", 5.5, "#FFFFFF"]}},
    {"id": "graticule", "type": "line", "source": "graticule", "maxzoom": 5, "paint": {"line-color": "#C6CDCC", "line-width": 0.7}},
    {"id": "ne_land", "type": "fill", "source": "ne_countries", "paint": {"fill-color": "#FFFFFF", "fill-opacity": ["interpolate", ["linear"], ["zoom"], 4, 1, 5.5, 0], "fill-antialias": false}},
    {"id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water", "filter": ["all", ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false], ["!=", ["get", "brunnel"], "tunnel"]], "paint": {"fill-color": "#D3D9D8"}},
    {"id": "tint", "type": "fill", "source": "ne_countries", "paint": {"fill-color": "#FF5A1F", "fill-opacity": ["*", 0.32, ["coalesce", ["feature-state", "v"], 0]]}},
    {"id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway", "minzoom": 3, "filter": ["match", ["get", "class"], ["river"], true, false], "layout": {"line-cap": "round"}, "paint": {"line-color": "#B9C6C6", "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.6, 10, 2]}},
    {"id": "road_major", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 4, "filter": ["all", ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false], ["match", ["get", "class"], ["motorway", "trunk", "primary"], true, false]], "layout": {"line-cap": "round", "line-join": "round"}, "paint": {"line-color": "#E3DCCE", "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.6, 12, 2.5]}},
    {"id": "boundary_state", "type": "line", "source": "openmaptiles", "source-layer": "boundary", "minzoom": 3, "filter": ["all", [">=", ["coalesce", ["get", "admin_level"], 99], 3], ["<=", ["coalesce", ["get", "admin_level"], 0], 4], ["!=", ["get", "maritime"], 1]], "paint": {"line-color": "#CFCCC3", "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.5, 10, 1], "line-dasharray": [3, 3]}},
    {"id": "ne_borders", "type": "line", "source": "ne_borders", "layout": {"line-join": "round"}, "paint": {"line-color": "#A9A9A2", "line-width": ["interpolate", ["linear"], ["zoom"], 0, 0.5, 5, 1], "line-opacity": ["interpolate", ["linear"], ["zoom"], 4, 1, 5.5, 0]}},
    {"id": "boundary_country", "type": "line", "source": "openmaptiles", "source-layer": "boundary", "minzoom": 4, "filter": ["all", ["==", ["get", "admin_level"], 2], ["!=", ["get", "maritime"], 1]], "layout": {"line-join": "round"}, "paint": {"line-color": "#9C9C95", "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.8, 10, 1.4], "line-opacity": ["interpolate", ["linear"], ["zoom"], 4, 0, 5.5, 1]}},
    {"id": "hover", "type": "line", "source": "ne_countries", "layout": {"line-join": "round"}, "paint": {"line-color": "#141414", "line-width": 1.8, "line-opacity": ["case", ["boolean", ["feature-state", "hover"], false], 1, 0]}},
    {"id": "label_city", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "minzoom": 3.5, "filter": ["all", ["==", ["get", "class"], "city"], ["<=", ["coalesce", ["get", "rank"], 99], ["step", ["zoom"], 2, 5, 5, 7, 9]]], "layout": {"text-field": ["coalesce", ["get", "name_en"], ["get", "name:latin"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": 12, "text-max-width": 8, "text-anchor": "left", "text-offset": [0.5, 0]}, "paint": {"text-color": "#141414", "text-halo-color": "#FFFFFF", "text-halo-width": 1.4}},
    {"id": "label_country", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "minzoom": 2, "maxzoom": 7, "filter": ["all", ["==", ["get", "class"], "country"], ["<=", ["coalesce", ["get", "rank"], 99], ["step", ["zoom"], 1, 3, 3, 4, 5]]], "layout": {"text-field": ["coalesce", ["get", "name_en"], ["get", "name:latin"], ["get", "name"]], "text-font": ["Noto Sans Bold"], "text-size": 10, "text-transform": "uppercase", "text-letter-spacing": 0.22, "text-max-width": 8}, "paint": {"text-color": "#7A7A73", "text-halo-color": "#FFFFFF", "text-halo-width": 1}}
  ]
}
