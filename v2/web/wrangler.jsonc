{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mapr",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // "routes": [{ "pattern": "mapr.stbrn.studio", "custom_domain": true }],

  "build": { "command": "node scripts/build-client.mjs" },
  "assets": {
    "directory": "./dist/public",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/live", "/healthz"]
  },

  "triggers": { "crons": ["* * * * *"] },

  "kv_namespaces": [
    // `wrangler kv namespace create SNAPSHOT`, then paste the id here.
    { "binding": "SNAPSHOT", "id": "00000000000000000000000000000000" }
  ],

  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "LiveHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveHub"] }],

  "vars": {
    // Public hostname of the Cloudflare Tunnel in front of the ingestor API (127.0.0.1:8787).
    "INGEST_URL": "https://ingest.example.invalid"
  },
  // Secret, never in this file: `wrangler secret put INGEST_TOKEN` (the ingestor's API_TOKEN).
  // Local dev: put INGEST_TOKEN=... in .dev.vars.

  "observability": { "enabled": true }
}
