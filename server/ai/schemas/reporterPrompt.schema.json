{
  "type": "object",
  "additionalProperties": false,
  "required": ["questions", "reporters"],
  "properties": {
    "questions": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["question"],
        "additionalProperties": false,
        "properties": {
          "question": { "type": "string", "minLength": 12, "maxLength": 240 },
          "why":      { "type": "string", "maxLength": 280 }
        }
      }
    },
    "reporters": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name":   { "type": "string", "minLength": 2, "maxLength": 120 },
          "outlet": { "type": "string", "maxLength": 120 },
          "beat":   { "type": "string", "maxLength": 200 }
        }
      }
    }
  }
}
